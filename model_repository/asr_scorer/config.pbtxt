name: "asr_scorer"
backend: "python"
max_batch_size: 8

input [
  {
    name: "ENCODER_OUT"
    data_type: TYPE_FP32
    dims: [-1, -1]
  },
  {
    name: "ENCODER_OUT_LEN"
    data_type: TYPE_INT64
    dims: [1]
  }
]

output [
  {
    name: "TRANSCRIPT"
    data_type: TYPE_STRING
    dims: [1]
  }
]

instance_group [
  {
    kind: KIND_GPU
    count: 2
  }
]
